---
import { buildDataset } from '../lib/dataset';
import type { CaissonProduct } from '../lib/types';
import '../styles/global.css';

const ds = buildDataset();
// Un seul tableau exposé au client ; la règle « incertains masqués par défaut »
// est appliquée au filtrage (filter.ts), pas en cachant les données.
const produits: CaissonProduct[] = [...ds.confirmes, ...ds.incertains];

const payload = {
  produits,
  facettes: {
    gammes: ds.gammes,
    pieces: ds.pieces,
    montages: ds.montages,
  },
  compteurs: {
    confirmes: ds.confirmes.length,
    incertains: ds.incertains.length,
  },
};

// Marque par gamme (pour l'attribut title des chips Gamme). Prend la 1re occurrence.
const marqueParGamme: Record<string, string> = {};
for (const p of produits) if (!(p.gamme in marqueParGamme)) marqueParGamme[p.gamme] = p.enseigne;

// Bornes des curseurs = ESPACE DISPONIBLE de l'utilisateur (spec hifi), pas les cotes
// produits : un mur peut dépasser le plus grand caisson. Le dataset gouverne quels
// produits existent ; ces bornes gouvernent la contrainte que l'utilisateur exprime.
const SLIDERS = {
  w: { min: 20, max: 400, def: 240, rep: 'mur', label: 'Largeur disponible' },
  d: { min: 20, max: 70, def: 45, rep: 'dégagement', label: 'Profondeur max' },
  h: { min: 35, max: 260, def: 200, rep: 'sous plafond', label: 'Hauteur max' },
};
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Comparateur de caissons par dimensions — Vimiac</title>
    <meta
      name="description"
      content="Filtre de faisabilité : réglez largeur, profondeur et hauteur, et voyez en direct — dessiné à l'échelle — quels caissons rentrent. Sans prix, sans image produit, sans collecte de données."
    />
    <meta property="og:title" content="Est-ce qu'un caisson tient dans mon espace ?" />
    <meta
      property="og:description"
      content="Trois curseurs, un dessin technique du mur qui se met à jour en direct, une grille de caissons à l'échelle. Filtre de faisabilité dimensionnel."
    />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#resultats">Aller aux résultats</a>

    <header class="site-header">
      <p class="eyebrow">Filtre de faisabilité · dimensions uniquement</p>
      <div>
        <h1>Est-ce qu'un caisson <span class="accent">tient dans mon espace ?</span></h1>
        <p class="tagline">
          Réglez vos trois contraintes. Le dessin se met à jour en direct et montre ce qui
          rentre — à l'échelle, au centimètre.
        </p>
      </div>
      <div class="counters">
        <div class="counter" aria-hidden="true">
          <span class="num" id="cnt-fit">—</span>
          <span class="lbl">qui rentrent</span>
        </div>
        <div class="counter passive">
          <span class="num">{payload.compteurs.confirmes}</span>
          <span class="lbl">référencés</span>
        </div>
      </div>
    </header>

    <div class="layout">
      <!-- ================= FILTRES ================= -->
      <form id="filtres" class="filtres" aria-label="Contraintes et filtres" novalidate>
        <div class="filtres-head">
          <h2 class="section-title">Contraintes</h2>
          <button type="button" id="reset" class="btn-reset">réinitialiser</button>
        </div>

        <div class="sliders">
          {(['w', 'd', 'h'] as const).map((axis) => {
            const s = SLIDERS[axis];
            return (
              <div class="slider" data-axis={axis}>
                <label class="slider-label" for={`s-${axis}`}>
                  <span>{s.label}</span>
                  <span class="val" id={`v-${axis}`}>{s.def} cm</span>
                </label>
                <input type="range" id={`s-${axis}`} min={s.min} max={s.max} value={s.def} step="1"
                  aria-label={`${s.label} (cm)`} />
                <div class="scale">
                  <span>{s.min}</span><span class="rep">{s.rep}</span><span>{s.max}</span>
                </div>
              </div>
            );
          })}
        </div>

        <hr class="sep" />

        <div class="search">
          <input type="search" id="q" name="q" autocomplete="off" placeholder="nom, gamme…"
            aria-label="Rechercher (nom, gamme, marque, type)" />
        </div>

        {[
          { id: 'gammes', label: 'Gamme', values: payload.facettes.gammes, counts: true },
          { id: 'pieces', label: 'Pièce', values: payload.facettes.pieces, counts: false },
          { id: 'montages', label: 'Montage', values: payload.facettes.montages, counts: false },
        ].map((fam) => (
          <div class="chip-group" data-family={fam.id}>
            <span class="section-title">{fam.label}</span>
            <div class="chips-wrap">
              {fam.values.map((v: string) => (
                <button type="button" class="chip" role="switch" aria-pressed="false"
                  data-family={fam.id} data-value={v}
                  title={fam.counts ? marqueParGamme[v] : undefined}>
                  <span class="chip-txt" data-label={v}>{v}</span>
                  {fam.counts && <span class="count" data-count-for={v}></span>}
                </button>
              ))}
            </div>
          </div>
        ))}

        <div class="chip-group">
          <div class="chips-wrap">
            <button type="button" class="chip" id="chip-inc" role="switch" aria-pressed="false"
              title="Inclure les combinaisons non vérifiées (badge « non vérifié »)">
              inclure les non vérifiées
            </button>
          </div>
        </div>

        <p class="legal-mentions">
          Cotes indicatives issues de sources publiques, à vérifier auprès de l'enseigne.
          Marques citées à titre descriptif — ce comparateur n'est ni le vendeur ni affilié.
          Fixation murale anti-basculement obligatoire selon la notice du fabricant.
        </p>
      </form>

      <!-- ================= CONTENU ================= -->
      <main class="content">
        <!-- Mur d'essai -->
        <section class="mur-essai" aria-label="Mur d'essai, vue de face">
          <div class="mur-essai-head">
            <span class="title">Mur d'essai — vue de face</span>
            <span class="scale-note" id="mur-scale"></span>
            <span class="state" id="mur-state" role="status" aria-live="polite"></span>
          </div>
          <div id="mur-svg"></div>
          <p class="mur-essai-foot">
            Ajustement dimensionnel calculé sur les cotes — ce n'est pas une recommandation de montage.
          </p>
        </section>

        <!-- Résultats -->
        <section id="resultats" aria-label="Résultats">
          <div class="results-head">
            <h2 class="section-title" id="res-count">Résultats</h2>
            <span class="sort-label">trier</span>
            <div class="sort-chips" id="sort-chips" role="group" aria-label="Tri">
              <button type="button" class="chip" data-sort="largeur_cm" aria-pressed="true">L</button>
              <button type="button" class="chip" data-sort="profondeur_cm" aria-pressed="false">P</button>
              <button type="button" class="chip" data-sort="hauteur_cm" aria-pressed="false">H</button>
              <button type="button" class="chip" data-sort="nom" aria-pressed="false">Nom</button>
            </div>
          </div>
          <div id="cards" aria-live="polite"></div>
        </section>

        <noscript>
          <p class="empty-state">
            JavaScript est nécessaire pour régler les contraintes et dessiner le mur.
            Les {payload.compteurs.confirmes} combinaisons vérifiées restent listées ci-dessous.
          </p>
        </noscript>
      </main>
    </div>

    <!-- ================= COMPOSER UN MUR (module conservé : doctrine + liens) ================= -->
    <section id="mur" class="mur" aria-label="Composer un mur">
      <h2>Composer un mur</h2>
      <p class="mur-intro">
        Donnez les dimensions du mur : le module propose des combinaisons de caissons
        (empilables) qui <strong>tiennent dans l'espace</strong>, avec un
        <strong>avertissement propre à chaque combinaison</strong>. C'est un
        <strong>fait géométrique</strong> sur les cotes — <em>pas</em> une recommandation de montage.
      </p>
      <form id="mur-form" class="mur-form" novalidate>
        <div class="mur-champs">
          <label>Largeur du mur (cm)
            <input type="number" id="mur-largeur" min="1" max="600" step="0.1" value="300" required />
          </label>
          <label>Profondeur max (cm)
            <input type="number" id="mur-profondeur" min="1" max="120" step="0.1" value="60" required />
          </label>
          <label>Hauteur souhaitée (cm) <span class="mur-hint">maximum à ne pas dépasser</span>
            <input type="number" id="mur-hauteur" min="1" max="400" step="0.1" value="220" required />
          </label>
          <label>Gamme (optionnel)
            <select id="mur-gamme">
              <option value="">Toutes les gammes</option>
              {payload.facettes.gammes.map((g: string) => <option value={g}>{g}</option>)}
            </select>
          </label>
        </div>
        <label class="check mur-toggle">
          <input type="checkbox" id="mur-force" />
          <span>Forcer une <strong>gamme unique</strong> sur toute la pile (empilement dans la même collection)</span>
        </label>
        <button type="submit" class="mur-go">Composer</button>
      </form>

      <div id="mur-results" class="mur-out" aria-live="polite"></div>

      <p class="mur-secu">
        <strong>Sécurité — renvoi au fabricant.</strong> Les combinaisons sont calculées sur les
        cotes uniquement. Un empilement affiché indique un <strong>ajustement dimensionnel</strong>,
        pas un montage recommandé. Suivez toujours la <strong>notice de montage</strong> et les
        consignes de <strong>fixation murale / anti-basculement</strong> du fabricant.
      </p>
    </section>

    <footer class="site-footer">
      <p>
        Données <strong>dimensionnelles indicatives</strong>, établies à partir de sources
        publiques, susceptibles d'erreurs — à vérifier auprès de l'enseigne. Les marques citées
        le sont à titre <strong>descriptif</strong> ; ce comparateur n'est ni le vendeur ni affilié
        à ces enseignes. Aucun prix, aucune image, aucune référence article, aucune collecte de données.
      </p>
    </footer>

    <script type="application/json" id="dataset-json" set:html={JSON.stringify(payload)} />
    <script src="../scripts/app.ts"></script>
    <script src="../scripts/mur-ui.ts"></script>
  </body>
</html>
